# ==============================================================================
# NextGen Web Studio — Environment Configuration Template
# Autonomous AI Engineering | Full-Stack Web Development | Telegram Bot Systems
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Administrative Security
ADMIN_EMAIL=nextgenwebstudio63@gmail.com

# Razorpay Payment Gateway (Optional - for client billing & online payments)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Google OAuth 2.0 (Optional - for client portal authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Transactional Email Service (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_NAME="NextGen Web Studio"
RESEND_FROM_EMAIL=billing@nextgenwebstudio.in

# Supabase Cloud Database (Optional - falls back to robust local JSON persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Telegram Bot Token (Optional - for direct server alerts)
TELEGRAM_BOT_TOKEN=your_botfather_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here
